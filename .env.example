# =====================================================================
# Salin file ini menjadi .env.local (development) atau isi di
# Vercel → Project → Settings → Environment Variables (production).
# JANGAN commit file .env.local. Variabel tanpa NEXT_PUBLIC_ hanya dibaca server.
# =====================================================================
# URL production (sitemap, canonical, Open Graph). Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — server only
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Migrasi database otomatis -----------------------------------------
# Project Settings → Database → Connection string → URI (Session pooler, port 5432).
# Dipakai oleh `npm run db:migrate` dan otomatis saat `npm run build` (Vercel).
# Kosongkan jika tidak ingin migrasi berjalan saat build.
SUPABASE_DB_URL=

# --- Google Maps / Places (Google Cloud Console) -----------------------
# Server only. Aktifkan "Places API (New)". GOOGLE_PLACES_API_KEY dipakai lebih dulu,
# jika kosong memakai GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
# Place ID bisnis (bisa juga diisi lewat Admin → Pengaturan Website). Contoh: ChIJxxxxxxxxxxxxxxxx
GOOGLE_PLACE_ID=

# --- WhatsApp -----------------------------------------------------------
# Nomor utama diatur di Admin → Pengaturan Website. Nilai ini dipakai jika
# nomor di Admin masih kosong (format internasional tanpa +).
WHATSAPP_NUMBER=6281234567890

# --- Email (Resend — https://resend.com) --------------------------------
EMAIL_SERVICE_KEY=re_xxxxxxxxxxxxxxxxx
# Pengirim harus dari domain yang sudah diverifikasi di Resend
EMAIL_FROM="Website Furniture <noreply@domain-anda.com>"
# Fallback tujuan notifikasi jika "Email notifikasi" di Admin kosong
EMAIL_TO=admin@domain-anda.com

# --- Google Analytics 4 (opsional) -------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
