{
  "name": "furniture-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db.mjs setup --if-configured && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "seed:sql": "node --experimental-strip-types scripts/generate-seed.ts",
    "placeholders": "python3 scripts/generate-placeholders.py",
    "icons": "node scripts/generate-icons.mjs",
    "build:app": "next build",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:setup": "node scripts/db.mjs setup",
    "db:status": "node scripts/db.mjs status",
    "admin:create": "node scripts/create-admin.mjs",
    "verify": "node scripts/verify-crud.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.53.0",
    "next": "^15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "swiper": "^14.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
